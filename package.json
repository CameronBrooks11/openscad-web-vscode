{
  "name": "openscad-web-vscode",
  "displayName": "OpenSCAD Web Viewer",
  "description": "Preview OpenSCAD models in a VS Code webview — render OFF meshes and live-compile multi-file .scad projects via the openscad-web WASM engine (no native install).",
  "version": "0.3.0",
  "publisher": "cameronbrooks11",
  "license": "GPL-3.0-or-later",
  "private": true,
  "icon": "icon.png",
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CameronBrooks11/openscad-web-vscode.git"
  },
  "homepage": "https://github.com/CameronBrooks11/openscad-web-vscode#readme",
  "bugs": {
    "url": "https://github.com/CameronBrooks11/openscad-web-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "openscad",
    "scad",
    "3d",
    "off",
    "geometry",
    "viewer",
    "cad",
    "webgl"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "OpenSCAD Web Viewer",
      "properties": {
        "openscadWeb.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "OPENSCADPATH-style user library directories (absolute, or relative to the first workspace folder). Each **top-level directory** under a path is one library: `use <DirName/file.scad>`. A user library fully shadows a bundled one of the same name."
        },
        "openscadWeb.compileTrigger": {
          "type": "string",
          "enum": [
            "onSave",
            "manual"
          ],
          "enumDescriptions": [
            "Recompile the previewed project when any .scad file under its root is saved or changes on disk.",
            "Recompile only via the 'OpenSCAD Viewer: Preview .scad File (compile)' command."
          ],
          "default": "onSave",
          "description": "When to recompile the live .scad preview after it has been opened."
        }
      }
    },
    "commands": [
      {
        "command": "openscadWebViewer.showFixture",
        "title": "OpenSCAD Viewer: Show Fixture Geometry"
      },
      {
        "command": "openscadWebViewer.openOffFile",
        "title": "OpenSCAD Viewer: Preview .off File"
      },
      {
        "command": "openscadWebViewer.previewScad",
        "title": "OpenSCAD Viewer: Preview .scad File (compile)"
      },
      {
        "command": "openscadWebViewer.exportScad",
        "title": "OpenSCAD Viewer: Export Model (STL, 3MF, GLB, …)"
      },
      {
        "command": "openscadWebViewer.setView",
        "title": "OpenSCAD Viewer: Set Camera View"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .off",
          "command": "openscadWebViewer.openOffFile",
          "group": "navigation@9"
        },
        {
          "when": "resourceExtname == .scad",
          "command": "openscadWebViewer.previewScad",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .off",
          "command": "openscadWebViewer.openOffFile",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .scad",
          "command": "openscadWebViewer.previewScad",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-viewer": "node ./scripts/sync-viewer.mjs",
    "verify-viewer": "node ./scripts/verify-viewer-manifest.mjs",
    "sync-session": "node ./scripts/sync-session.mjs",
    "verify-session": "node ./scripts/verify-session-manifest.mjs",
    "make-icon": "node ./scripts/make-icon.mjs",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node --test \"out/**/__tests__/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run compile && npm run test:unit && npm run verify-viewer && npm run verify-session",
    "package": "vsce package --no-dependencies -o openscad-web-vscode.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^10.6.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
